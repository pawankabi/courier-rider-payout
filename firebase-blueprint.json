  "firestore": {
    "/public_statements/{riderId}": {
      "schema": "public_statements",
      "description": "Public read-only rider statements/ledgers accessible without login via secure link"
    },
    "/workspaces/{userId}/riders/{riderId}": {
      "schema": "riders",
      "description": "User isolated workspace collection storing riders belonging strictly to userId"
    },
    "/workspaces/{userId}/entries/{entryId}": {
      "schema": "deliveries",
      "description": "User isolated workspace collection storing delivery entries belonging strictly to userId"
    },
    "/workspaces/{userId}/settlements/{settlementId}": {
      "schema": "settlements",
      "description": "User isolated workspace collection storing settlement receipts belonging strictly to userId"
    },
    "/workspaces/{userId}/advances/{advanceId}": {
      "schema": "advances",
      "description": "User isolated workspace collection storing rider advance/recovery entries belonging to userId"
    },
    "/workspaces/{userId}/incentives/{incentiveId}": {
      "schema": "incentives",
      "description": "User isolated workspace collection storing rider incentive entries belonging to userId"
    },
    "/advances/{advanceId}": {
      "schema": "advances",
      "description": "Legacy/global rider advance entries mirrored for public ledger lookup"
    },
    "/incentives/{incentiveId}": {
      "schema": "incentives",
      "description": "Legacy/global rider incentive entries mirrored for public ledger lookup"
    },
    "/all_users/{userId}": {
      "schema": "all_users",
      "description": "Central user registry for super-admin governance, approval, and feature permissions"
    },
    "/system_settings/{settingId}": {
      "schema": "system_settings",
      "description": "System-wide default configurations such as subscription defaults for new users"
    },
    "/hubs/{hubId}/daily_cod_sheets/{sheetId}": {
      "schema": "deliveries",
      "description": "Multi-tenant hub-isolated daily COD sheets avoiding cross-hub rider leakage"
    }
  }
}

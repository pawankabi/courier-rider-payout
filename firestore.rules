rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'pawankabiseraikella@gmail.com') ||
        (request.auth.token.keys().hasAny(['email']) && request.auth.token.email.lower() == 'pawankabiseraikella@gmail.com')
      );
    }

    // Master Admin pawankabiseraikella@gmail.com has full read and write access to all documents across the database
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Central registry of all users for admin management and access approvals
    match /all_users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }

    // System-wide default settings (subscription defaults for new users, app configs)
    match /system_settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Isolated per-user multi-tenant workspaces: /workspaces/{userId}/riders and /workspaces/{userId}/entries
    match /workspaces/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());

      match /riders/{riderId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      match /entries/{entryId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      match /settlements/{settlementId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      match /{allSubpaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    // Primary database collections for riders, deliveries, and settlements
    match /riders/{riderId} {
      allow read, write: if request.auth != null;
    }

    match /deliveries/{deliveryId} {
      allow read, write: if request.auth != null;
    }

    match /settlements/{settlementId} {
      allow read, write: if request.auth != null;
    }

    // User root profile document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());

      // User's own riders subcollection
      match /riders/{riderId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      // User's own deliveries subcollection
      match /deliveries/{deliveryId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      // User's own settlements subcollection
      match /settlements/{settlementId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      // Any additional nested subcollections
      match /{allSubpaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }
    }
  }
}

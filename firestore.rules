rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() == 'pawankabiseraikella@gmail.com';
    }

    function isOwnerDoc(data) {
      return request.auth != null && (
        isSuperAdmin() ||
        data.userId == request.auth.uid ||
        data.workspaceId == request.auth.uid ||
        data.createdBy == request.auth.uid
      );
    }

    // Master Admin pawankabiseraikella@gmail.com has full read and write access to all documents across the database
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Central registry of all users for admin management and access approvals
    match /all_users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }

    // Razorpay payment verification registry
    match /razorpay_payments/{paymentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // System-wide default settings (subscription defaults for new users, app configs)
    match /system_settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /admin_config/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Public real-time OTA App Updates Manifest (for Android APK and Web live update checks)
    match /app_updates/{docId} {
      allow read, write: if true;
    }

    // Isolated per-user multi-tenant workspaces: /workspaces/{userId}/riders and /workspaces/{userId}/entries
    match /workspaces/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());

      match /riders/{riderId} {
        allow read: if true; // Public read for ledger statement verification
        allow create, update: if request.auth != null; // Admin + Companion anonymous auth for COD shortage conversion
        allow delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      match /entries/{entryId} {
        allow read: if true; // Public read for delivery earnings verification
        allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      match /settlements/{settlementId} {
        allow read: if true; // Public read for payout settlement verification
        allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      match /advances/{advanceId} {
        allow read: if true; // Public read for rider advance ledger verification
        allow create, update: if request.auth != null; // Admin + Companion anonymous auth for COD shortage advance creation
        allow delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      match /incentives/{incentiveId} {
        allow read: if true; // Public read for rider incentive ledger verification
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      match /{allSubpaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    // Primary database collections for riders, deliveries, settlements, and auto-backups (Strict Zero Hard-Delete Policy)
    match /riders/{riderId} {
      allow read, create, update: if true; // Public read & sync for rider profile & advances
      allow delete: if isOwnerDoc(resource.data); // Owner/Admin can permanently purge trashed records
    }

    // Public read-only statements/ledgers accessible without login
    match /public_statements/{statementId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null && (isSuperAdmin() || isOwnerDoc(resource.data));
    }

    // COD Staff PINs & Access Control for companion mobile web app login (Delivery boys & Hub Staff)
    match /cod_staff_pins/{pinId} {
      allow read, write: if true;
    }

    // COD Audit Logs for inspection and history recovery
    match /workspaces/{userId}/cod_audit_logs/{logId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Real-time Daily COD Sheets for 0-second companion app synchronization
    match /daily_cod_sheets/{sheetId} {
      allow read, create, update: if true;
      allow delete: if false;
      match /{allSubpaths=**} {
        allow read, create, update: if true;
        allow delete: if false;
      }
    }

    // Isolated Hub paths for multi-tenant COD sheets, immutable auto-archives, and auto-backups
    match /hubs/{hubId} {
      allow read, create, update: if true;
      allow delete: if false;
      match /{allSubpaths=**} {
        allow read, create, update: if true;
        allow delete: if false;
      }
    }

    match /deliveries/{deliveryId} {
      allow read, create, update: if true; // Public read & sync for rider delivery logs
      allow delete: if isOwnerDoc(resource.data); // Owner/Admin can permanently purge trashed deliveries
    }

    match /settlements/{settlementId} {
      allow read, create, update: if true; // Public read & sync for rider payout settlements
      allow delete: if false; // Settlement audit trail cannot be hard deleted
    }

    match /advances/{advanceId} {
      allow read, create, update: if true; // Public read & sync for rider advance logs
      allow delete: if isOwnerDoc(resource.data); // Owner/Admin can permanently purge trashed advances
    }

    match /incentives/{incentiveId} {
      allow read, create, update: if true; // Public read & sync for rider incentive logs
      allow delete: if isOwnerDoc(resource.data); // Owner/Admin can permanently purge trashed incentives
    }

    // Collection Group Queries for Public Statements (allows unauthenticated query by riderId)
    match /{path=**}/riders/{riderId} {
      allow read: if true;
    }

    match /{path=**}/entries/{entryId} {
      allow read: if true;
    }

    match /{path=**}/settlements/{settlementId} {
      allow read: if true;
    }

    match /{path=**}/advances/{advanceId} {
      allow read: if true;
    }

    match /{path=**}/incentives/{incentiveId} {
      allow read: if true;
    }

    match /{path=**}/public_statements/{statementId} {
      allow read: if true;
    }

    // User root profile document and subcollections
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());

      // User's own riders subcollection
      match /riders/{riderId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      // User's own deliveries subcollection
      match /deliveries/{deliveryId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      // User's own settlements subcollection
      match /settlements/{settlementId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      // Any additional nested subcollections
      match /{allSubpaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }
    }
  }
}
